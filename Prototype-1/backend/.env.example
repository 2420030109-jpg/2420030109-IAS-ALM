# Copy to .env and fill in. .env is gitignored; this template is committed.

# Postgres (Neon). Leave unset to fall back to a local SQLite file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Flask session signing key.
SECRET_KEY=change-me

# Demo login seeded on startup so the console is usable immediately.
# Remove both to disable seeding.
SEED_ADMIN_USERNAME=ajithesh
SEED_ADMIN_PASSWORD=ajithesh
